---
import type { Note } from '../lib/content';
import { url } from '../lib/url';
import Diagram from './Diagram.astro';
interface Props {
  note: Note;
  topic: string;
  index: number;
}
const { note: n, topic, index } = Astro.props,
  key = `n/${topic}/${n.id}`;
---

<article class="note-section" id={`note-${n.id}`}>
  <div class="section-heading">
    <span class="section-number">{String(index + 1).padStart(2, '0')}</span>
    <h3>{n.title}</h3>
    <button class="save-button" data-save={key} aria-pressed="false">
      + Lưu lại
    </button>
  </div>
  {n.body.map((p) => (
    <p>{p}</p>
  ))}
  {n.diagram && <Diagram diagram={n.diagram} id={`${topic}-${n.id}`} />}
  {n.table && (
    <div class="table-scroll" tabindex="0" role="region" aria-label={`Bảng ${n.title}`}>
      <table>
        <thead>
          <tr>
            {n.table.headers.map((h) => (
              <th scope="col">{h}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {n.table.rows.map((row) => (
            <tr>
              {row.map((c) => (
                <td>{c}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
  {n.example && <pre><code>{n.example}</code></pre>}
  {n.pitfall && (
    <aside class="callout caution">
      <strong>Dễ hiểu nhầm</strong>
      <p>{n.pitfall}</p>
    </aside>
  )}
  {n.exercise && (
    <aside class="callout">
      <strong>Tự kiểm tra kiến thức</strong>
      <p>{n.exercise}</p>
    </aside>
  )}
  {n.download && (
    <a class="button secondary" href={url(n.download.url)} download>
      {n.download.title} ↓
    </a>
  )}
</article>
