---
import Shell from '../layouts/Shell.astro';
import { handbookGroups, handbookLessons, handbookPath, type HandbookLesson } from '../lib/handbook';
import { url } from '../lib/url';
import { topics } from '../lib/content';
import ArchitectureExplorer from './ArchitectureExplorer';
import HandbookExperiment from './HandbookExperiment';
import BuildTimeline from './BuildTimeline';
import Estimator from './Estimator';
import ConceptWorksheet, {type WorksheetKind} from './ConceptWorksheet';
import SystemWorksheet, {type SystemWorksheetKind} from './SystemWorksheet';
import RoutingPlayground from './RoutingPlayground';
import CachePlayground from './CachePlayground';
import DatabasePlayground from './DatabasePlayground';
import ConsistencyPlayground from './ConsistencyPlayground';
import LearningFlow from './LearningFlow.astro';
import LearningCards from './LearningCards.astro';
import InterviewPlanner from './InterviewPlanner';
import MessagingPlayground from './MessagingPlayground';
import RateLimitPlayground from './RateLimitPlayground';
import IdentifierPlayground from './IdentifierPlayground';
import ReliabilityPlayground from './ReliabilityPlayground';
import ShortLinkPlayground from './ShortLinkPlayground';
import ChatPlayground from './ChatPlayground';
import NotificationPlayground from './NotificationPlayground';
import AutocompletePlayground from './AutocompletePlayground';
import CrawlerPlayground from './CrawlerPlayground';
import VideoPlayground from './VideoPlayground';
import MetricsPlayground from './MetricsPlayground';
import MapsPlayground from './MapsPlayground';
import NearbyPlayground from './NearbyPlayground';
import ObjectStoragePlayground from './ObjectStoragePlayground';
import ExchangePlayground from './ExchangePlayground';
import CollaborativePlayground from './CollaborativePlayground';
import ServingPlayground from './ServingPlayground';
import EmailPlayground from './EmailPlayground';
import LogPlayground from './LogPlayground';
import WalletPlayground from './WalletPlayground';
import SchedulerPlayground from './SchedulerPlayground';
import SearchPlayground from './SearchPlayground';
import NetflixPlayground from './NetflixPlayground';
import PaymentPlatformPlayground from './PaymentPlatformPlayground';
import RidePlatformPlayground from './RidePlatformPlayground';
import LlmSchedulingPlayground from './LlmSchedulingPlayground';
import ParallelismPlayground from './ParallelismPlayground';
import ServingStackPlayground from './ServingStackPlayground';
import PromptContractPlayground from './PromptContractPlayground';
import RagLearningPlayground from './RagLearningPlayground';
import FineTunePlayground from './FineTunePlayground';
import EvaluationPlayground from './EvaluationPlayground';
import AgentRuntimePlayground from './AgentRuntimePlayground';
import ProductionAppPlayground from './ProductionAppPlayground';
import AiSecurityPlayground from './AiSecurityPlayground';
import EnterpriseRagPlayground from './EnterpriseRagPlayground';
import CodingAssistantPlayground from './CodingAssistantPlayground';
import LlmGatewayPlayground from './LlmGatewayPlayground';
import DesignStudio from './DesignStudio';
import DailyReview from './DailyReview';
import { buildReviewDeck } from '../lib/review-deck';
import KvCachePlayground from './KvCachePlayground';
import CreatorVideoPlayground from './CreatorVideoPlayground';
import DesignCanvasPlayground from './DesignCanvasPlayground';
import SecureMessengerPlayground from './SecureMessengerPlayground';
import StayMarketplacePlayground from './StayMarketplacePlayground';
import AudioPlatformPlayground from './AudioPlatformPlayground';
import CheckoutPlayground from './CheckoutPlayground';
import PhotoPlatformPlayground from './PhotoPlatformPlayground';
import CommunityChatPlayground from './CommunityChatPlayground';
import ReservationPlayground from './ReservationPlayground';
import AdClickPlayground from './AdClickPlayground';
import LeaderboardPlayground from './LeaderboardPlayground';
import PaymentPlayground from './PaymentPlayground';
import MerklePlayground from './MerklePlayground';
import ProximityPlayground from './ProximityPlayground';
import FileSyncPlayground from './FileSyncPlayground';
import '../styles/handbook.css';
interface Props { lesson: HandbookLesson }
const { lesson } = Astro.props;
const prerequisites = lesson.prerequisites.map(id => handbookLessons.find(l => l.id === id)).filter(Boolean);
const related = lesson.relatedTopics.map(id => topics.find(t=>t.id===id)).filter(Boolean);
---
<Shell title={lesson.title.vi} description={lesson.summary.vi} toc={lesson.sections.map(s => ({ id: s.id, text: s.title.vi }))}>
  <article class="rich-handbook">
    <header class="page-heading">
      <a class="eyebrow" href={url('/system-design/')}>{handbookGroups[lesson.group].vi}</a>
      <h1>{lesson.title.vi}</h1><p>{lesson.summary.vi}</p>
      {prerequisites.length > 0 && <div class="handbook-prerequisites"><span>Học trước:</span>{prerequisites.map(p => p && <a href={url(handbookPath(p))}>{p.title.vi} →</a>)}</div>}
      {related.length > 0 && <nav class="handbook-related" aria-label="Notes và câu hỏi liên quan"><span>Ôn cùng Notes & Interview</span>{related.map(t=>t&&<a href={url(`/handbook/${t.id}/`)}><span>{t.title}</span><span aria-hidden="true">↗</span></a>)}</nav>}
    </header>
    {lesson.overview && <LearningFlow flow={lesson.overview} overview />}
    <aside class="takeaways"><span class="eyebrow">GHI NHỚ TRƯỚC KHI ĐỌC</span><ul>{lesson.takeaways.map(t => <li>{t.vi}</li>)}</ul></aside>
    {lesson.sections.map(section => <section class="handbook-section" aria-labelledby={section.id}>
      <h2 id={section.id}>{section.title.vi}</h2>
      {section.flow && <LearningFlow flow={section.flow} />}
      {section.cards && <LearningCards cards={section.cards} />}
      {section.paragraphs.map(p => <p>{p.vi}</p>)}
      {section.bullets && <ul>{section.bullets.map(p => <li>{p.vi}</li>)}</ul>}
      {section.table && <figure class="handbook-table"><div role="region" aria-label={section.title.vi} tabindex="0"><table><thead><tr>{section.table.headers.map(h => <th scope="col">{h.vi}</th>)}</tr></thead><tbody>{section.table.rows.map(row => <tr>{row.map((cell, i) => i === 0 ? <th scope="row">{cell.vi}</th> : <td>{cell.vi}</td>)}</tr>)}</tbody></table></div>{section.table.caption && <figcaption>{section.table.caption.vi}</figcaption>}</figure>}
      {section.api && <div class="handbook-api">{section.api.map(api => <section>
        <header><span class="http-method" data-method={api.method}>{api.method}</span><code>{api.path}</code></header>
        <p>{api.description.vi}</p>
        {api.request && <pre tabindex="0" role="region" aria-label={section.title.vi}><code>{api.request}</code></pre>}
        <pre tabindex="0" role="region" aria-label={section.title.vi}><code>{api.response}</code></pre>
        {api.notes && <ul>{api.notes.map(note => <li>{note.vi}</li>)}</ul>}
      </section>)}</div>}
      {section.code && <figure><pre tabindex="0" role="region" aria-label={section.title.vi}><code class={`language-${section.code.language}`}>{section.code.content}</code></pre><figcaption>{section.code.caption.vi}</figcaption></figure>}
      {section.diagram && <>
        <ArchitectureExplorer client:visible diagram={section.diagram} />
        <details class="handbook-transcript"><summary>Đọc sơ đồ dạng văn bản</summary>
          {section.diagram.traces.map(trace => <section><h3>{trace.label.vi}</h3><ol>{trace.steps.map(step => <li>{step.description.vi}</li>)}</ol></section>)}
          <dl>{section.diagram.nodes.map(node => <><dt>{node.label.vi}</dt><dd>{node.detail.vi}</dd></>)}</dl>
        </details>
      </>}
      {section.stages && <><BuildTimeline client:visible stages={section.stages} /><details class="handbook-transcript"><summary>Đọc tất cả giai đoạn</summary>{section.stages.map(stage => <section><h3>{stage.title.vi}</h3><p>{stage.description.vi}</p>{stage.problem && <p><strong>Áp lực cần giải quyết: </strong>{stage.problem.vi}</p>}{stage.decision && <p><strong>Quyết định kiến trúc: </strong>{stage.decision.vi}</p>}{stage.tradeoff && <p><strong>Chi phí và đánh đổi: </strong>{stage.tradeoff.vi}</p>}{stage.nextPressure && <p><strong>Khi nào cần bước tiếp? </strong>{stage.nextPressure.vi}</p>}<p>{stage.exitCriteria.vi}</p>{stage.diagram?.traces.map(trace=><><h4>{trace.label.vi}</h4><ol>{trace.steps.map(step=><li>{step.description.vi}</li>)}</ol></>)}</section>)}</details></>}
      {section.experiment && (section.experiment === 'feed-fanout' || section.experiment === 'kv-budget') && <HandbookExperiment client:visible kind={section.experiment} />}
      {section.experiment === 'capacity' && <Estimator client:visible />}
      {section.experiment && ['context-budget','roofline','availability','latency'].includes(section.experiment) && <ConceptWorksheet client:visible kind={section.experiment as WorksheetKind} />}
      {section.experiment === 'interview-plan' && section.planner && <InterviewPlanner client:visible plan={section.planner} />}
      {section.experiment && ['handshake','transport','saturation'].includes(section.experiment) && <SystemWorksheet client:visible kind={section.experiment as SystemWorksheetKind} />}
      {(section.experiment === 'balancer' || section.experiment === 'hash-ring') && <RoutingPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'cache-eviction' || section.experiment === 'cache-burst') && <CachePlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'db-isolation' || section.experiment === 'lsm' || section.experiment === 'sharding') && <DatabasePlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'replication-lag' || section.experiment === 'quorum' || section.experiment === 'raft') && <ConsistencyPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'consumer-groups' || section.experiment === 'delivery-crash' || section.experiment === 'offset-gaps') && <MessagingPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'rate-race' || section.experiment === 'counter-race') && <RateLimitPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'id-bits' || section.experiment === 'id-locality') && <IdentifierPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'dependency-availability' || section.experiment === 'retry-storm' || section.experiment === 'circuit-breaker') && <ReliabilityPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'url-space' || section.experiment === 'redirect-cache') && <ShortLinkPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'chat-routing' || section.experiment === 'chat-sync') && <ChatPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'notification-crash' || section.experiment === 'notification-pipeline') && <NotificationPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'prefix-index' || section.experiment === 'suggestion-race') && <AutocompletePlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'crawl-frontier' || section.experiment === 'bloom-budget') && <CrawlerPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'video-dag' || section.experiment === 'video-abr' || section.experiment === 'video-bandwidth') && <VideoPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'sync-chunks' || section.experiment === 'sync-conflict') && <FileSyncPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'geo-cover' || section.experiment === 'geo-quadtree') && <ProximityPlayground client:visible kind={section.experiment} />}
      {section.experiment === 'merkle-repair' && <MerklePlayground client:visible />}
      {(section.experiment === 'payment-retry' || section.experiment === 'payment-ledger') && <PaymentPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'board-replay' || section.experiment === 'board-shards') && <LeaderboardPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'click-windows' || section.experiment === 'click-sink') && <AdClickPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'booking-nights' || section.experiment === 'booking-expiry') && <ReservationPlayground client:visible kind={section.experiment} />}
      {section.experiment === 'daily-review' && <DailyReview client:visible cards={buildReviewDeck()} subjects={topics.map(t=>({id:t.id,title:t.title}))} />}
      {section.experiment === 'design-studio' && <DesignStudio client:visible />}
      {(section.experiment === 'gateway-route' || section.experiment === 'gateway-failover' || section.experiment === 'gateway-accounting') && <LlmGatewayPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'coding-race' || section.experiment === 'coding-context' || section.experiment === 'coding-patch') && <CodingAssistantPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'enterprise-access' || section.experiment === 'enterprise-revoke' || section.experiment === 'enterprise-migrate') && <EnterpriseRagPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'security-paths' || section.experiment === 'security-url' || section.experiment === 'security-moderation') && <AiSecurityPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'prod-stream' || section.experiment === 'prod-cache' || section.experiment === 'prod-cost') && <ProductionAppPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'agent-loop' || section.experiment === 'agent-effect' || section.experiment === 'agent-context') && <AgentRuntimePlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'eval-pairs' || section.experiment === 'eval-judge' || section.experiment === 'eval-gates') && <EvaluationPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'tune-plan' || section.experiment === 'tune-budget' || section.experiment === 'tune-cost') && <FineTunePlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'rag-ranks' || section.experiment === 'rag-ivf' || section.experiment === 'rag-publication') && <RagLearningPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'prompt-grammar' || section.experiment === 'prompt-validation' || section.experiment === 'prompt-tools') && <PromptContractPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'stack-routing' || section.experiment === 'stack-adapters' || section.experiment === 'stack-economics') && <ServingStackPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'parallel-layout' || section.experiment === 'parallel-pipeline' || section.experiment === 'parallel-experts') && <ParallelismPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'batch-interference' || section.experiment === 'spec-mass' || section.experiment === 'spec-cost' || section.experiment === 'batch-handoff') && <LlmSchedulingPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'kv-ranks' || section.experiment === 'kv-pages' || section.experiment === 'kv-prefix' || section.experiment === 'kv-transfer') && <KvCachePlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'creator-retrieval' || section.experiment === 'creator-codec' || section.experiment === 'creator-prefetch') && <CreatorVideoPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'design-properties' || section.experiment === 'design-recovery' || section.experiment === 'design-refill') && <DesignCanvasPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'secure-fanout' || section.experiment === 'secure-delivery' || section.experiment === 'secure-membership') && <SecureMessengerPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'stay-calendar' || section.experiment === 'stay-quote' || section.experiment === 'stay-cdc') && <StayMarketplacePlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'audio-start' || section.experiment === 'audio-events' || section.experiment === 'audio-playlist') && <AudioPlatformPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'checkout-stock' || section.experiment === 'checkout-cart' || section.experiment === 'checkout-cells') && <CheckoutPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'photo-ids' || section.experiment === 'photo-publish' || section.experiment === 'photo-stories') && <PhotoPlatformPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'community-reads' || section.experiment === 'community-fanout' || section.experiment === 'community-resume') && <CommunityChatPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'ride-match' || section.experiment === 'ride-claims' || section.experiment === 'ride-location') && <RidePlatformPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'platform-processor' || section.experiment === 'platform-inbox' || section.experiment === 'platform-migrate') && <PaymentPlatformPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'netflix-quality' || section.experiment === 'netflix-fill' || section.experiment === 'netflix-live') && <NetflixPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'search-index' || section.experiment === 'search-fanout' || section.experiment === 'search-refresh') && <SearchPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'sched-fencing' || section.experiment === 'sched-catchup' || section.experiment === 'sched-dst') && <SchedulerPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'wallet-recovery' || section.experiment === 'wallet-transfer' || section.experiment === 'wallet-holds') && <WalletPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'log-seek' || section.experiment === 'log-replicas' || section.experiment === 'log-visibility') && <LogPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'email-receipt' || section.experiment === 'email-auth' || section.experiment === 'email-spam' || section.experiment === 'email-sync') && <EmailPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'serving-batch' || section.experiment === 'serving-placement' || section.experiment === 'serving-usage') && <ServingPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'collab-pair' || section.experiment === 'collab-anchors' || section.experiment === 'collab-durable') && <CollaborativePlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'exchange-book' || section.experiment === 'exchange-recovery' || section.experiment === 'exchange-risk') && <ExchangePlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'object-erasure' || section.experiment === 'object-multipart' || section.experiment === 'object-reader') && <ObjectStoragePlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'nearby-fanout' || section.experiment === 'nearby-viewer' || section.experiment === 'nearby-recovery') && <NearbyPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'maps-tiles' || section.experiment === 'maps-routing' || section.experiment === 'maps-eta') && <MapsPlayground client:visible kind={section.experiment} />}
      {(section.experiment === 'metrics-cardinality' || section.experiment === 'metrics-rollup' || section.experiment === 'metrics-alert') && <MetricsPlayground client:visible kind={section.experiment} />}
      {section.callout && <aside class:list={['callout', { caution: section.callout.tone === 'warning' }]}><strong>{section.callout.title.vi}</strong><p>{section.callout.body.vi}</p></aside>}
      {section.questions && <div class="handbook-questions">{section.questions.map((q, i) => <details><summary><span class="section-number">{String(i + 1).padStart(2,'0')}</span>{q.question.vi}</summary><div>{q.answer.map(p => <p>{p.vi}</p>)}{q.followup && <aside class="callout"><strong>Đào sâu thêm</strong><p>{q.followup.vi}</p></aside>}</div></details>)}</div>}
    </section>)}
    <a class="button secondary" href={url('/system-design/')}>Khám phá System Design & AI →</a>
  </article>
</Shell>
