---
import { tracks, topics, groups, url } from '../lib/content';
import { cases } from '../lib/cases';
import { base } from '../lib/url';
import Icon from './Icon.astro';
import NavBranch from './NavBranch.astro';
const path = Astro.url.pathname;
const relative = path.slice(base.length) || '/';
const exact = (p: string) => relative === p;
const inSection = (p: string) => relative.startsWith(p);
const activeTopic = topics.find((t) => inSection(`/handbook/${t.id}/`));
const activeCase = cases.find((c) => exact(`/handbook/system-design/${c.id}/`));
const activeChapter = tracks
  .flatMap((t) => t.chapters)
  .find((c) => exact(`/learn/${c.track}/${c.slug}/`));
const currentLabel = activeCase?.title || activeChapter?.title || activeTopic?.title;
---

<aside class="sidebar" id="navigation" aria-label="Điều hướng chính">
  <a class="brand" href={url('/')}>
    <span class="brand-mark">
      <Icon name="grid" size={23} />
    </span>
    <span>
      AV Lore<small>LEARN. UNDERSTAND. BUILD.</small>
    </span>
  </a>
  <nav aria-label="Nội dung học tập">
    <div class="nav-main">
      <a
        href={url('/')}
        class:list={{ active: exact('/') }}
        aria-current={exact('/') ? 'page' : undefined}
      >
        <Icon name="grid" />
        <span>Tổng quan</span>
      </a>
    </div>
    <NavBranch id="learn" label="Lộ trình học" active={inSection('/learn/')} count={tracks.length}>
      <a
        class="nav-overview"
        href={url('/learn/')}
        aria-current={exact('/learn/') ? 'page' : undefined}
      >
        Tất cả lộ trình
      </a>
      {tracks.map((t) => (
        <NavBranch
          id={`track-${t.id}`}
          label={t.title}
          active={inSection(`/learn/${t.id}/`)}
          count={t.chapters.length}
          level={1}
        >
          <a
            class="nav-overview"
            href={url(`/learn/${t.id}/`)}
            aria-current={exact(`/learn/${t.id}/`) ? 'page' : undefined}
          >
            Tổng quan lộ trình
          </a>
          {t.chapters.map((c) => (
            <a
              class="nav-leaf"
              href={url(`/learn/${t.id}/${c.slug}/`)}
              aria-current={exact(`/learn/${t.id}/${c.slug}/`) ? 'page' : undefined}
            >
              <span class="nav-item-number">{String(c.order).padStart(2, '0')}</span>
              <span>{c.title.replace(/^Chương\s*\d+\s*[.:—–-]?\s*/i, '')}</span>
            </a>
          ))}
        </NavBranch>
      ))}
    </NavBranch>
    <NavBranch
      id="handbook"
      label="Notes & Interview"
      active={inSection('/handbook/')}
      count={topics.length}
    >
      <a
        class="nav-overview"
        href={url('/handbook/')}
        aria-current={exact('/handbook/') ? 'page' : undefined}
      >
        Tất cả topic
      </a>
      {groups.map((g) => (
        <NavBranch
          id={`group-${g.split(' ')[0]}`}
          label={g.replace(/^\d+ · /, '')}
          active={activeTopic?.group === g}
          level={1}
        >
          {topics
            .filter((t) => t.group === g)
            .map((t) => (
              <NavBranch
                id={`topic-${t.id}`}
                label={t.title}
                active={activeTopic?.id === t.id}
                level={2}
              >
                <a
                  class="nav-overview"
                  href={url(`/handbook/${t.id}/`)}
                  aria-current={exact(`/handbook/${t.id}/`) ? 'page' : undefined}
                >
                  Tổng quan topic
                </a>
                {[
                  ['#try', 'Thử để hiểu'],
                  ['#notes', 'Notes'],
                  ['#interview', 'Interview'],
                ].map(([hash, label]) => (
                  <a class="nav-section-link" href={url(`/handbook/${t.id}/${hash}`)}>
                    {label}
                    <span aria-hidden="true">↗</span>
                  </a>
                ))}
                {t.id === 'system-design' && (
                  <NavBranch
                    id="system-design-cases"
                    label="Case studies"
                    active={!!activeCase}
                    count={cases.length}
                    level={3}
                  >
                    {cases.map((c, i) => (
                      <a
                        class="nav-leaf"
                        href={url(`/handbook/system-design/${c.id}/`)}
                        aria-current={activeCase?.id === c.id ? 'page' : undefined}
                      >
                        <span class="nav-item-number">{String(i + 1).padStart(2, '0')}</span>
                        <span>{c.title}</span>
                        {activeCase?.id === c.id && (
                          <span class="current-indicator" aria-label="Đang đọc">
                            ●
                          </span>
                        )}
                      </a>
                    ))}
                  </NavBranch>
                )}
              </NavBranch>
            ))}
        </NavBranch>
      ))}
    </NavBranch>
    <div class="nav-main nav-tools">
      {[
        ['/practice/', 'Phòng thực hành', 'lab'],
        ['/saved/', 'Góc học tập', 'bookmark'],
      ].map(([href, label, icon]) => (
        <a
          href={url(href)}
          class:list={{ active: exact(href) }}
          aria-current={exact(href) ? 'page' : undefined}
        >
          <Icon name={icon} />
          <span>{label}</span>
        </a>
      ))}
    </div>
  </nav>
  <div class="sidebar-footer">
    {currentLabel && (
      <div class="reading-location">
        <span>ĐANG ĐỌC</span>
        <strong>{currentLabel}</strong>
      </div>
    )}
    <a href={url('/about/')} aria-current={exact('/about/') ? 'page' : undefined}>
      Giới thiệu AV Lore <span>↗</span>
    </a>
  </div>
</aside>
