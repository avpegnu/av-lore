---
import type { Diagram } from '../lib/content';
interface Props {
  diagram: Diagram;
  id: string;
}
const { diagram: d, id } = Astro.props;
const marker = `arr-${id}`,
  title = `diagram-${id}`;
const nodes = d.type === 'flow' ? d.nodes : [],
  actors = d.type === 'sequence' ? d.actors : [];
const width = d.type === 'sequence' ? Math.max(720, actors.length * 200) : 640;
const height =
  d.type === 'flow'
    ? nodes.length * 76
    : d.type === 'sequence'
      ? 110 + d.steps.length * 64
      : d.type === 'boxes'
        ? 400
        : Math.max(...d.nodes.map((n) => n[1])) + 65;
const xs = actors.map((_, i) => 100 + (i * (width - 200)) / Math.max(1, actors.length - 1));
---

<figure class="diagram">
  <figcaption id={title}>{d.title}</figcaption>
  <div class="diagram-scroll" tabindex="0" role="region" aria-labelledby={title}>
    <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${title}-svg`}>
      <title id={`${title}-svg`}>{d.title} — {d.caption}</title>
      <defs>
        <marker id={marker} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
          <path d="M0 0L8 4L0 8" class="arrow-fill" />
        </marker>
      </defs>
      {d.type === 'flow' &&
        nodes.map((label, i) => (
          <g>
            {i > 0 && (
              <line
                x1="320"
                y1={i * 76 - 20}
                x2="320"
                y2={i * 76 + 4}
                marker-end={`url(#${marker})`}
              />
            )}
            <rect x="45" y={i * 76 + 8} width="550" height="48" rx="10" />
            <text x="320" y={i * 76 + 38} text-anchor="middle">
              {i + 1}. {label}
            </text>
          </g>
        ))}
      {d.type === 'sequence' && (
        <>
          {actors.map((a, i) => (
            <g>
              <rect x={xs[i] - 85} y="12" width="170" height="42" rx="9" />
              <text x={xs[i]} y="38" text-anchor="middle">
                {a}
              </text>
              <line x1={xs[i]} y1="58" x2={xs[i]} y2={height - 10} stroke-dasharray="4 7" />
            </g>
          ))}
          {d.steps.map(([a, b, label], i) => (
            <g>
              <text x={(xs[a] + xs[b]) / 2} y={93 + i * 64} text-anchor="middle">
                {i + 1}. {label}
              </text>
              <line
                x1={xs[a]}
                y1={109 + i * 64}
                x2={xs[b]}
                y2={109 + i * 64}
                marker-end={`url(#${marker})`}
              />
            </g>
          ))}
        </>
      )}
      {d.type === 'graph' && (
        <>
          {d.edges.map(([a, b]) => {
            const [x1, y1] = d.nodes[a],
              [x2, y2] = d.nodes[b],
              ang = Math.atan2(y2 - y1, x2 - x1),
              r = Math.min(
                64 / Math.max(0.001, Math.abs(Math.cos(ang))),
                24 / Math.max(0.001, Math.abs(Math.sin(ang))),
              );
            return (
              <line
                x1={x1 + r * Math.cos(ang)}
                y1={y1 + r * Math.sin(ang)}
                x2={x2 - (r + 5) * Math.cos(ang)}
                y2={y2 - (r + 5) * Math.sin(ang)}
                marker-end={`url(#${marker})`}
              />
            );
          })}
          {d.nodes.map(([x, y, label]) => (
            <g>
              <rect x={x - 64} y={y - 24} width="128" height="48" rx="9" />
              <text x={x} y={y + 5} text-anchor="middle">
                {label}
              </text>
            </g>
          ))}
        </>
      )}
      {d.type === 'boxes' &&
        d.labels.map((label, i) => (
          <g>
            <rect
              x={20 + i * 40}
              y={20 + i * 45}
              width={600 - i * 80}
              height={360 - i * 90}
              rx="9"
            />
            <text x={33 + i * 40} y={46 + i * 45}>
              {label}
            </text>
          </g>
        ))}
    </svg>
  </div>
  <p class="caption">{d.caption}</p>
</figure>
