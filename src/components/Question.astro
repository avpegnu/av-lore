---
import type { Topic } from '../lib/content';
interface Props {
  question: Topic['questions'][number];
  topic: string;
  index: number;
}
const { question: q, topic, index } = Astro.props,
  key = `q/${topic}/${q.id}`;
---

<details class="question" id={`question-${q.id}`}>
  <summary>
    <span class="question-index">{String(index + 1).padStart(2, '0')}</span>
    <span>
      {q.question}
      <small>{q.level}</small>
    </span>
    <span class="plus" aria-hidden="true">
      +
    </span>
  </summary>
  <div class="question-answer">
    <p class="eyebrow">GỢI Ý TRẢ LỜI</p>
    <p>{q.answer}</p>
    <p class="muted">{q.explanation}</p>
    <aside class="callout">
      <strong>Câu hỏi đào sâu</strong>
      <p>{q.followUp}</p>
    </aside>
    <a class="text-link" href={`#note-${q.note}`}>
      Đọc lại note liên quan ↑
    </a>
    <div class="answer-actions">
      <button data-save={key} class="save-button" aria-pressed="false">
        + Lưu lại
      </button>
      <button data-rating="known" data-key={key} aria-pressed="false">
        Đã hiểu
      </button>
      <button data-rating="review" data-key={key} aria-pressed="false">
        Cần ôn lại
      </button>
    </div>
  </div>
</details>
