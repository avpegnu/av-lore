---
import Icon from './Icon.astro';
import { base, url } from '../lib/url';
const route = Astro.url.pathname.slice(base.length) || '/';
const current = route === '/404/' ? '/404.html' : route;
---

<details class="language-menu" id="language-menu">
  <summary
    class="icon-button language-toggle"
    aria-label="Đổi ngôn ngữ / Change language"
    title="Ngôn ngữ / Language"
  >
    <Icon name="languages" size={19} />
    <span data-lang-code>VI</span>
  </summary>
  <nav class="language-popup" aria-label="Chọn ngôn ngữ">
    <a data-language="vi" href={url(current)} aria-current="true">
      <span>Tiếng Việt</span>
      <span data-language-check>✓</span>
    </a>
    <a data-language="en" href={url('/en' + current)}>
      <span>English</span>
      <span data-language-check></span>
    </a>
  </nav>
</details>
