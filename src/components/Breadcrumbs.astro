---
import { topics, tracks, url } from '../lib/content';
import { base } from '../lib/url';
import { cases } from '../lib/cases';
const { title } = Astro.props;
const relative = Astro.url.pathname.slice(base.length) || '/';
const crumbs: { label: string; href?: string }[] = [{ label: 'AV Lore', href: '/' }];
if (relative.startsWith('/handbook/')) {
  crumbs.push({ label: 'Notes & Interview', href: '/handbook/' });
  const topic = topics.find((t) => relative.startsWith(`/handbook/${t.id}/`));
  if (topic) {
    crumbs.push({ label: topic.title, href: `/handbook/${topic.id}/` });
    const study = cases.find((c) => relative === `/handbook/system-design/${c.id}/`);
    if (study) crumbs.push({ label: study.title });
  }
} else if (relative.startsWith('/learn/')) {
  crumbs.push({ label: 'Lộ trình học', href: '/learn/' });
  const track = tracks.find((t) => relative.startsWith(`/learn/${t.id}/`));
  if (track) {
    crumbs.push({ label: track.title, href: `/learn/${track.id}/` });
    const chapter = track.chapters.find((c) => relative === `/learn/${track.id}/${c.slug}/`);
    if (chapter) crumbs.push({ label: chapter.title });
  }
} else if (relative !== '/') crumbs.push({ label: title });
if (relative === '/') crumbs.push({ label: 'Tổng quan' });
---

<nav class="breadcrumb" aria-label="Đường dẫn trang">
  <ol>
    {crumbs.map((c, i) => (
      <li>
        {i < crumbs.length - 1 && c.href ? (
          <a href={url(c.href)}>{c.label}</a>
        ) : (
          <span aria-current="page">{c.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
