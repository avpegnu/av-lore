---
interface Props {
  id: string;
  label: string;
  active?: boolean;
  count?: number;
  level?: number;
}
const { id, label, active = false, count, level = 0 } = Astro.props;
---

<details
  class:list={['nav-branch', `nav-level-${level}`, { 'is-current-branch': active }]}
  open={active}
  data-nav-id={id}
  data-active={active ? 'true' : undefined}
>
  <summary>
    <svg
      class="nav-chevron"
      viewBox="0 0 16 16"
      width="15"
      height="15"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      aria-hidden="true"
    >
      <path d="m6 3 5 5-5 5" />
    </svg>
    <span class="nav-branch-label">{label}</span>
    {count !== undefined && <span class="nav-count">{count}</span>}
  </summary>
  <div class="nav-children">
    <slot />
  </div>
</details>
