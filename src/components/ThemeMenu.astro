---
import Icon from './Icon.astro';
---

<details class="theme-menu" id="theme-menu">
  <summary id="theme-toggle" class="icon-button" aria-label="Chọn giao diện" title="Giao diện">
    <Icon name="sun" />
  </summary>
  <div class="theme-popup">
    <p>Giao diện</p>
    {[
      ['dark', 'Tối hiện đại', 'Nền than · nhấn xanh'],
      ['github-dimmed', 'Tối xanh xám', 'Nền xanh xám · nhấn xanh'],
      ['midnight', 'Xanh đêm', 'Nền xanh đậm · nhấn xanh nhạt'],
      ['latte', 'Sáng pastel', 'Nền sáng lạnh · nhấn tím'],
      ['light', 'Sáng giấy', 'Nền trắng ngà · nhấn xanh lá'],
    ].map(([theme, name, description]) => (
      <button type="button" data-theme-choice={theme} aria-pressed={theme === 'dark'}>
        <span class={`theme-swatch swatch-${theme}`}></span>
        <span>
          <strong>{name}</strong>
          <small>{description}</small>
        </span>
        <span class="theme-check" aria-hidden="true">
          ✓
        </span>
      </button>
    ))}
  </div>
</details>
