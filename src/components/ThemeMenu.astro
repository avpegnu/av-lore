---
import Icon from './Icon.astro';
import themeOptions from '../lib/themes.json';
import { url } from '../lib/url';
---

<details class="theme-menu" id="theme-menu">
  <summary id="theme-toggle" class="icon-button" aria-label="Chọn giao diện" title="Giao diện">
    <Icon name="sun" />
  </summary>
  <div class="theme-popup">
    {['dark', 'light'].map((mode) => (
      <section class="theme-group">
        <p class="theme-group-label">{mode === 'dark' ? 'Giao diện tối' : 'Giao diện sáng'}</p>
        {themeOptions
          .filter((theme) => theme.mode === mode)
          .map((theme) => (
            <button
              type="button"
              data-theme-choice={theme.id}
              aria-pressed={theme.id === 'github-dark'}
            >
              <span class="theme-swatch" data-theme={theme.id}></span>
              <span>
                <strong>{theme.name}</strong>
                <small>{theme.description}</small>
              </span>
              <span class="theme-check" aria-hidden="true">
                ✓
              </span>
            </button>
          ))}
      </section>
    ))}
    <a class="theme-library-link" href={url('/themes/')}>
      So sánh tất cả theme →
    </a>
  </div>
</details>
