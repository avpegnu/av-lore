---
import Icon from './Icon.astro';
import type {z} from 'zod';
import type {learningCardsSchema} from '../lib/handbook-schema';
interface Props {cards:z.infer<typeof learningCardsSchema>}
const {cards}=Astro.props;
---
<div class="learning-cards">{cards.map(card=><section class="learning-card" data-tone={card.tone}><header><Icon name={card.icon} size={20}/><h3>{card.title.vi}</h3></header><ul>{card.items.map(item=><li>{item.vi}</li>)}</ul></section>)}</div>
