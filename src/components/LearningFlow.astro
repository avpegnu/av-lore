---
import Icon from './Icon.astro';
import type {z} from 'zod';
import type {learningFlowSchema} from '../lib/handbook-schema';
interface Props {flow:z.infer<typeof learningFlowSchema>;overview?:boolean}
const {flow,overview=false}=Astro.props;
---
<figure class:list={['learning-flow',{'lesson-overview':overview}]}>
 <figcaption><span class="eyebrow">{overview?'BẢN ĐỒ BÀI HỌC':'THEO DÕI TỪNG BƯỚC'}</span><strong>{flow.title.vi}</strong></figcaption>
 <ol style={`--flow-steps:${flow.steps.length}`}>{flow.steps.map((step,i)=><li><span class="learning-flow-icon"><Icon name={step.icon} size={23}/></span><span class="learning-step-number">{String(i+1).padStart(2,'0')}</span><strong>{step.title.vi}</strong><p>{step.detail.vi}</p><span class="learning-flow-arrow" aria-hidden="true"><Icon name="arrow" size={19}/></span></li>)}</ol>
 <p class="learning-flow-caption">{flow.caption.vi}</p>
</figure>
