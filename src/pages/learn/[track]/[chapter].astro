---
import Shell from '../../../layouts/Shell.astro';
import { courses, url, prose } from '../../../lib/content';
export function getStaticPaths() {
  return courses.map((chapter) => ({
    params: { track: chapter.track, chapter: chapter.slug },
    props: { chapter },
  }));
}
const { chapter: c } = Astro.props;
const siblings = courses.filter((x) => x.track === c.track),
  idx = siblings.findIndex((x) => x.id === c.id),
  prev = siblings[idx - 1],
  next = siblings[idx + 1];
---

<Shell title={c.title} description={c.description} section="learn" toc={c.headings}>
  <Fragment slot="head">
    {c.track === 'ai' && (
      <>
        <link rel="stylesheet" href={url('/course-labs/ai-base.css')} />
        {c.order > 1 && <link rel="stylesheet" href={url(`/course-labs/ai-${c.slug}.css`)} />}
      </>
    )}
  </Fragment>
  <header class="page-heading">
    <a class="eyebrow" href={url(`/learn/${c.track}/`)}>
      {c.trackTitle} / CHƯƠNG {String(c.order).padStart(2, '0')}
    </a>
    <h1>{c.title}</h1>
    <p>{c.description}</p>
    <div class="meta-row">
      <span>◷ Khoảng {c.readingMinutes} phút đọc</span>
      <span>Nội dung từ lộ trình hiện có</span>
    </div>
  </header>
  <div class="prose legacy-prose" set:html={prose(c.html)} />
  {c.track === 'ai' && c.order > 1 && (
    <script is:inline src={url(`/course-labs/ai-${c.slug}.js`)} defer />
  )}
  {c.track === 'cli' && <script is:inline src={url('/course-labs/terminal.js')} defer />}
  <div class="chapter-complete">
    <button data-chapter={c.id} aria-pressed="false">
      Đánh dấu đã học
    </button>
    <a href={url('/handbook/')}>Ôn lại với Notes & Interview →</a>
  </div>
  <nav class="prev-next" aria-label="Các chương lân cận">
    {prev ? (
      <a href={url(`/learn/${prev.track}/${prev.slug}/`)}>
        <small>← CHƯƠNG TRƯỚC</small>
        {prev.title}
      </a>
    ) : (
      <span />
    )}
    {next ? (
      <a href={url(`/learn/${next.track}/${next.slug}/`)}>
        <small>CHƯƠNG TIẾP →</small>
        {next.title}
      </a>
    ) : (
      <a href={url('/learn/')}>Xem lộ trình khác →</a>
    )}
  </nav>
</Shell>
