---
import Shell from '../../../layouts/Shell.astro';
import { tracks, url } from '../../../lib/content';
export function getStaticPaths() {
  return tracks.map((track) => ({ params: { track: track.id }, props: { track } }));
}
const { track } = Astro.props;
---

<Shell title={track.title} section="learn">
  <header class="page-heading">
    <span class="eyebrow">
      {track.group} / {track.chapters.length} CHƯƠNG
    </span>
    <h1>{track.title}</h1>
    <p>Nắm khái niệm, đọc ví dụ và thử tự giải thích trước khi chuyển sang chương tiếp theo.</p>
  </header>
  <div class="chapter-list">
    {track.chapters.map((c, i) => (
      <a href={url(`/learn/${track.id}/${c.slug}/`)}>
        <span class="section-number">{String(i + 1).padStart(2, '0')}</span>
        <div>
          <h2>{c.title}</h2>
          <p>{c.description}</p>
          <small>Khoảng {c.readingMinutes} phút đọc</small>
        </div>
        <span aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</Shell>
