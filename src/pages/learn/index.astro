---
import Shell from '../../layouts/Shell.astro';
import { tracks, stats, url } from '../../lib/content';
---

<Shell title="Lộ trình học" section="learn" wide>
  <header class="page-heading">
    <span class="eyebrow">01 / LEARN</span>
    <h1>Học từ nền tảng.</h1>
    <p>
      {stats.chapters} chương trong {tracks.length} lộ trình. Đọc theo thứ tự để xây nền vững, hoặc
      chọn phần bạn đang cần củng cố.
    </p>
  </header>
  <aside class="callout">
    <strong>Thứ tự gợi ý</strong>
    <p>
      Terminal → lập trình & OOP → DSA, OS, Networking → ứng dụng & Database → System Design,
      DevOps. AI Foundations là hướng mở rộng sau khi đã có lập trình và toán cơ bản.
    </p>
  </aside>
  {[...new Set(tracks.map((t) => t.group))].map((group) => (
    <section class="catalog-group">
      <h2>{group}</h2>
      <div class="topic-grid">
        {tracks
          .filter((t) => t.group === group)
          .map((t) => (
            <a class="topic-card" href={url(`/learn/${t.id}/`)}>
              <span class="card-meta">{t.chapters.length} CHƯƠNG</span>
              <h3>{t.title}</h3>
              <p>{t.chapters[0]?.title.replace(/^Chương \d+[:.\s–-]*/, '')}</p>
              <span class="card-cta">Xem lộ trình →</span>
            </a>
          ))}
      </div>
    </section>
  ))}
</Shell>
