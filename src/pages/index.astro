---
import Shell from '../layouts/Shell.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/content';
---

<Shell title="Tổng quan" wide>
  <div class="overview-heading">
    <span class="eyebrow">
      <i class="status-dot"></i> KHÔNG GIAN HỌC TẬP CỦA BẠN
    </span>
    <span class="edition">AV LORE / HANDBOOK</span>
  </div>
  <section class="hero">
    <div>
      <div class="hero-tag">Nền tảng vững. Tư duy rõ.</div>
      <h1>
        Hiểu bản chất.
        <br />
        <span>Học có hệ thống.</span>
      </h1>
      <p>
        Từ dòng code đầu tiên đến thiết kế một hệ thống.
        <br class="desktop-break" /> Kiến thức, sơ đồ và câu hỏi phỏng vấn — cùng một nơi.
      </p>
      <div class="hero-actions">
        <a class="button" href={url('/learn/')}>
          Bắt đầu lộ trình <Icon name="arrow" size={17} />
        </a>
        <a class="button secondary" href={url('/handbook/')}>
          Khám phá Handbook
        </a>
      </div>
    </div>
    <div class="hero-visual" aria-label="Luồng ứng dụng: Client, API, Service, Database">
      <div class="visual-caption">MỘT REQUEST ĐI QUA NHỮNG ĐÂU?</div>
      <div class="request-route">
        {[
          ['01', 'Client', 'Gửi yêu cầu'],
          ['02', 'API', 'Kiểm tra hợp đồng'],
          ['03', 'Service', 'Xử lý nghiệp vụ'],
          ['04', 'Database', 'Giữ dữ liệu đúng'],
        ].map(([n, t, d]) => (
          <div>
            <span>{n}</span>
            <strong>{t}</strong>
            <small>{d}</small>
          </div>
        ))}
      </div>
      <div class="visual-note">
        <span class="status-dot" /> Đừng chỉ nhớ tên. Hãy hiểu cách chúng kết nối.
      </div>
      <div class="visual-grid" aria-hidden="true"></div>
    </div>
  </section>
  <section class="home-section">
    <div class="section-title">
      <div>
        <span class="eyebrow">CHỌN CÁCH HỌC CỦA BẠN</span>
        <h2>Đi từ hiểu đến làm được.</h2>
      </div>
      <span class="muted">Ba lối vào, một nền tảng kiến thức.</span>
    </div>
    <div class="entry-grid">
      {[
        [
          'book',
          '01 / LEARN',
          'Học theo lộ trình',
          '198 chương đã có được tổ chức lại thành 15 lộ trình. Đi từ khái niệm tới ví dụ và bài tập.',
          '/learn/',
          'Xem các lộ trình',
        ],
        [
          'code',
          '02 / HANDBOOK',
          'Notes & Interview',
          '31 topic có tóm tắt, sơ đồ, ghi chú và câu hỏi đào sâu. Học từng phần hoặc ôn trước phỏng vấn.',
          '/handbook/',
          'Mở Handbook',
        ],
        [
          'lab',
          '03 / PRACTICE',
          'Thử để hiểu',
          'Thay đổi đầu vào, theo dõi luồng xử lý và quan sát điều gì xảy ra khi hệ thống gặp lỗi.',
          '/practice/',
          'Vào phòng thực hành',
        ],
      ].map(([icon, num, title, desc, href, cta]) => (
        <a class="entry-card" href={url(href)}>
          <div class="entry-card-top">
            <span class="tile-icon">
              <Icon name={icon} size={24} />
            </span>
            <small>{num}</small>
          </div>
          <h3>{title}</h3>
          <p>{desc}</p>
          <span class="card-cta">
            {cta} <Icon name="arrow" size={17} />
          </span>
        </a>
      ))}
    </div>
  </section>
  <section class="home-section">
    <div class="section-title">
      <div>
        <span class="eyebrow">LỘ TRÌNH GỢI Ý</span>
        <h2>Xây kiến thức theo từng lớp.</h2>
      </div>
      <a class="text-link" href={url('/learn/')}>
        Tất cả lộ trình ↗
      </a>
    </div>
    <div class="roadmap">
      {[
        ['01', 'Nền tảng', 'Terminal, DSA, OOP, OS và Networking.', 'cli'],
        ['02', 'Xây ứng dụng', 'Ngôn ngữ, Frontend, Backend và dữ liệu.', 'javascript'],
        ['03', 'Thiết kế & vận hành', 'System Design, DevOps và reliability.', 'system-design'],
        ['04', 'Mở rộng tư duy', 'AI Foundations và thực hành tích hợp.', 'ai'],
      ].map(([n, t, d, track]) => (
        <a href={url(`/learn/${track}/`)}>
          <span>{n}</span>
          <div>
            <h3>{t}</h3>
            <p>{d}</p>
          </div>
          <Icon name="arrow" size={18} />
        </a>
      ))}
    </div>
  </section>
  <section class="feature-banner">
    <div>
      <span class="eyebrow">SYSTEM DESIGN / 26 CASE STUDIES</span>
      <h2>
        Một sơ đồ đẹp chưa đủ.
        <br />
        Hệ thống gặp lỗi thì sao?
      </h2>
      <p>Bắt đầu từ requirements, đi theo dữ liệu và giải thích từng trade-off.</p>
      <a class="text-link" href={url('/handbook/system-design/')}>
        Khám phá các case study →
      </a>
    </div>
    <div class="mini-stack">
      <span>Requirements</span>
      <span>API & Data model</span>
      <span>Architecture</span>
      <span>Failure & Trade-offs</span>
    </div>
  </section>
</Shell>
