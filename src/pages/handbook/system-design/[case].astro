---
import Shell from '../../../layouts/Shell.astro';
import { cases } from '../../../lib/cases';
import { url } from '../../../lib/url';
import Diagram from '../../../components/Diagram.astro';
import Estimator from '../../../components/Estimator';
export function getStaticPaths() {
  return cases.map((c) => ({ params: { case: c.id }, props: { study: c } }));
}
const { study: c } = Astro.props,
  index = cases.findIndex((x) => x.id === c.id),
  next = cases[index + 1];
const toc = [
  { id: 'requirements', text: '1. Làm rõ yêu cầu' },
  { id: 'capacity', text: '2. Ước lượng capacity' },
  { id: 'api', text: '3. API & dữ liệu' },
  { id: 'architecture', text: '4. Luồng xử lý' },
  { id: 'deep', text: '5. Đào sâu quyết định' },
  { id: 'failure', text: '6. Lỗi & trade-off' },
  { id: 'drill', text: '7. Interview drill' },
  { id: 'sources', text: 'Nguồn tham khảo' },
];
---

<Shell title={`Thiết kế ${c.title}`} description={c.goal} toc={toc}>
  <header class="page-heading">
    <a class="eyebrow" href={url('/handbook/system-design/')}>
      SYSTEM DESIGN / CASE {String(index + 1).padStart(2, '0')}
    </a>
    <h1>
      Thiết kế
      <br />
      {c.title}
    </h1>
    <p>{c.goal}</p>
    <div class="meta-row">
      <span>Case study</span>
      <span>Yêu cầu → luồng dữ liệu → lỗi</span>
    </div>
  </header>
  <aside class="takeaways">
    <span class="eyebrow">BÀI TOÁN CẦN GIẢI</span>
    <p>{c.goal}</p>
    <p>
      Đây là thiết kế minh họa để luyện tư duy. Hãy điều chỉnh theo quy mô, SLO, ràng buộc và
      invariant bạn đã thống nhất với interviewer.
    </p>
  </aside>
  <section id="requirements">
    <h2>1. Làm rõ yêu cầu</h2>
    <ul>
      {c.requirements.map((r) => (
        <li>{r}</li>
      ))}
    </ul>
    <aside class="callout">
      <strong>Chốt phạm vi bằng số đo</strong>
      <p>
        Ai dùng hệ thống, thao tác nào quan trọng nhất, peak traffic, payload, retention, SLO
        latency/availability và dữ liệu nào phải nhất quán? Ghi rõ điều nằm ngoài phạm vi trước khi
        vẽ.
      </p>
    </aside>
  </section>
  <section id="capacity">
    <h2>2. Ước lượng capacity</h2>
    <p>
      Bắt đầu từ baseline rồi kiểm tra order of magnitude. Không có một con số capacity chung đúng
      cho mọi implementation của {c.title}.
    </p>
    <Estimator client:visible />
  </section>
  <section id="api">
    <h2>3. API & dữ liệu</h2>
    <p>
      Hợp đồng minh họa; status, validation, permission, pagination và versioning cần được chốt khi
      triển khai.
    </p>
    <pre><code>{c.api.join('\n')}</code></pre>
    <aside class="data-model">
      <span class="eyebrow">DATA MODEL / ACCESS PATTERN</span>
      <p>{c.data}</p>
    </aside>
  </section>
  <section id="architecture">
    <h2>4. Luồng xử lý</h2>
    <Diagram
      id={c.id}
      diagram={{
        type: 'flow',
        title: `Đường đi dữ liệu — ${c.title}`,
        nodes: c.flow,
        caption:
          'Mỗi bước là một trách nhiệm logic; không nhất thiết phải tách thành một microservice.',
      }}
    />
    <p>
      Với từng mũi tên, hãy chỉ ra input/output, timeout, owner của dữ liệu và điểm có thể retry.
      Xác định thời điểm trả thành công cho client so với thời điểm dữ liệu đủ bền vững.
    </p>
  </section>
  <section id="deep">
    <h2>5. Đào sâu quyết định</h2>
    {c.deep.map((p, i) => (
      <div class="deep-point">
        <span class="section-number">0{i + 1}</span>
        <p>{p}</p>
      </div>
    ))}
  </section>
  <section id="failure">
    <h2>6. Lỗi & trade-off</h2>
    <aside class="callout caution">
      <strong>Khi mọi thứ không đi theo happy path</strong>
      <p>{c.failure}</p>
    </aside>
    <aside class="callout">
      <strong>Điều bạn đang đánh đổi</strong>
      <p>{c.tradeoff}</p>
    </aside>
    <p>
      Đo latency, error rate, saturation và backlog của đường quan trọng; gắn alert với tác động
      người dùng. Chọn cách degrade và rollback trước khi tăng thêm component.
    </p>
  </section>
  <section id="drill">
    <h2>7. Interview drill</h2>
    <p>
      Dành 5 phút vẽ thiết kế, 10 phút đi qua một request và 5 phút thử làm hỏng một dependency. Hai
      câu hỏi sau cần lập luận theo thiết kế bạn chọn:
    </p>
    <ol>
      {c.drill.map((q) => (
        <li>{q}</li>
      ))}
    </ol>
    <p class="callout">
      Tự kiểm: bạn đã giải thích được invariant, thời điểm ACK, duplicate/retry, authorization và
      bottleneck đầu tiên chưa? Không cần thêm mọi công nghệ để làm câu trả lời “đủ lớn”.
    </p>
    <a class="button secondary" href={url('/handbook/system-design/#interview')}>
      Ôn bộ câu hỏi System Design →
    </a>
  </section>
  <section id="sources" class="source-section">
    <h2>Nguồn tham khảo</h2>
    <ul>
      <li>
        <a href={c.source.url} target="_blank" rel="noopener noreferrer">
          {c.source.title} ↗
        </a>
      </li>
    </ul>
    <p>Sơ đồ là mô hình minh họa để học và thảo luận các quyết định thiết kế.</p>
  </section>
  {next && (
    <a class="next-topic" href={url(`/handbook/system-design/${next.id}/`)}>
      <small>CASE TIẾP THEO</small>
      <strong>{next.title}</strong>
      <span>→</span>
    </a>
  )}
</Shell>
