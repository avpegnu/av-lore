---
import Shell from '../../layouts/Shell.astro';
import { topics, url } from '../../lib/content';
import { learning } from '../../lib/learning';
import { cases } from '../../lib/cases';
import Note from '../../components/Note.astro';
import Question from '../../components/Question.astro';
import Lab from '../../components/Lab';
export function getStaticPaths() {
  return topics.map((topic) => ({ params: { topic: topic.id }, props: { topic } }));
}
const { topic: t } = Astro.props,
  l = learning[t.id],
  index = topics.findIndex((x) => x.id === t.id),
  next = topics[index + 1];
const toc = [
  { id: 'quick', text: 'Nắm ý chính' },
  { id: 'try', text: 'Thử để hiểu' },
  { id: 'notes', text: `Notes (${t.notes.length})` },
  ...t.notes.map((n) => ({ id: `note-${n.id}`, text: n.title, depth: 3 })),
  ...(t.id === 'system-design' ? [{ id: 'cases', text: '26 Case studies' }] : []),
  { id: 'interview', text: `Interview (${t.questions.length})` },
  { id: 'sources', text: 'Đọc & đối chiếu' },
];
---

<Shell title={t.title} description={t.description} toc={toc}>
  <header class="page-heading">
    <span class="eyebrow">
      {t.group} / TOPIC {String(index + 1).padStart(2, '0')}
    </span>
    <h1>{t.title}</h1>
    <p>{t.description}</p>
    <div class="meta-row">
      <span>{t.notes.length} notes</span>
      <span>{t.questions.length} câu hỏi + follow-up</span>
      <span>1 bài thử tương tác</span>
    </div>
    {t.prerequisites.length > 0 && (
      <div class="prereqs">
        Nên đọc trước:{' '}
        {t.prerequisites.map((id) => {
          const p = topics.find((x) => x.id === id);
          return p && <a href={url(`/handbook/${id}/`)}>{p.title}</a>;
        })}
      </div>
    )}
  </header>
  <nav class="anchor-tabs" aria-label="Các phần của topic">
    <a href="#quick">Tổng quan</a>
    <a href="#try">Tương tác</a>
    <a href="#notes">Notes</a>
    <a href="#interview">Interview</a>
  </nav>
  <aside class="takeaways" id="quick">
    <span class="eyebrow">◷ NẮM Ý CHÍNH</span>
    <ul>
      {l.takeaways.map((s) => (
        <li>{s}</li>
      ))}
    </ul>
  </aside>
  <section class="memory-card">
    <span class="eyebrow">NHỚ BẰNG MỘT HÌNH DUNG</span>
    <p class="memory-analogy">{l.analogy}</p>
    <ol class="memory-flow">
      {l.path.map((s, i) => (
        <li>
          <span>{String(i + 1).padStart(2, '0')}</span>
          <strong>{s}</strong>
        </li>
      ))}
    </ol>
  </section>
  <section id="try">
    <h2>Thử để hiểu</h2>
    <p>Thay đổi điều kiện và quan sát kết quả. Hãy đoán trước khi chạy.</p>
    <Lab kind={l.lab} topic={t.id} client:visible />
    <noscript>
      <p class="callout">
        Bật JavaScript để dùng mô phỏng. Toàn bộ Notes, câu hỏi và sơ đồ bên dưới vẫn đọc được.
      </p>
    </noscript>
  </section>
  <section id="notes">
    <div class="section-title">
      <h2>
        Notes <span class="count">{t.notes.length}</span>
      </h2>
      <span class="muted">Khái niệm → ví dụ → tự kiểm tra</span>
    </div>
    {t.notes.map((n, i) => (
      <Note note={n} topic={t.id} index={i} />
    ))}
  </section>
  {t.id === 'system-design' && (
    <section id="cases">
      <h2>26 Case studies</h2>
      <p>
        Mỗi bài là một khung phân tích để tự triển khai và luyện thảo luận. Bắt đầu bằng yêu cầu cụ
        thể trước khi chọn công nghệ.
      </p>
      <div class="case-grid">
        {cases.map((c, i) => (
          <a href={url(`/handbook/system-design/${c.id}/`)}>
            <small>{String(i + 1).padStart(2, '0')}</small>
            <strong>{c.title}</strong>
            <span>→</span>
          </a>
        ))}
      </div>
    </section>
  )}
  <section id="interview">
    <h2>
      Interview <span class="count">{t.questions.length}</span>
    </h2>
    <p>
      Tự trả lời trước khi mở gợi ý. Dùng câu hỏi đào sâu để kiểm tra xem bạn có thể giải thích “vì
      sao” và “khi nào”.
    </p>
    {t.questions.map((q, i) => (
      <Question question={q} topic={t.id} index={i} />
    ))}
  </section>
  <section id="sources" class="source-section">
    <h2>Đọc & đối chiếu</h2>
    <p>Đọc tài liệu gốc để kiểm tra ngữ cảnh, phiên bản và giới hạn của từng khái niệm.</p>
    <ul>
      {t.sources.map((s) => (
        <li>
          <a href={s.url} target="_blank" rel="noopener noreferrer">
            {s.title} ↗
          </a>
        </li>
      ))}
    </ul>
  </section>
  <p id="storage-status" class="muted" role="status">
    Ghi chú đã lưu và đánh giá được giữ trên trình duyệt của bạn. Xuất dữ liệu ở Góc học tập để
    chuyển thiết bị.
  </p>
  {next && (
    <a class="next-topic" href={url(`/handbook/${next.id}/`)}>
      <small>TOPIC TIẾP THEO</small>
      <strong>{next.title}</strong>
      <span>→</span>
    </a>
  )}
</Shell>
