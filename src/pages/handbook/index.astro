---
import Shell from '../../layouts/Shell.astro';
import { topics, groups, stats, url } from '../../lib/content';
---

<Shell title="Notes & Interview" wide>
  <header class="page-heading">
    <span class="eyebrow">02 / HANDBOOK</span>
    <h1>
      Hiểu sâu. Nhớ lâu.
      <br />
      <span class="accent">Trả lời bằng tư duy.</span>
    </h1>
    <p>
      {stats.notes} ghi chú và {stats.questions} câu hỏi, chia theo {topics.length} topic. Mỗi topic
      có Notes, Interview và một bài thử tương tác riêng.
    </p>
  </header>
  <div class="reading-guide">
    <span>
      01 <strong>Nắm ý chính</strong>
    </span>
    <span>→</span>
    <span>
      02 <strong>Đọc & thử</strong>
    </span>
    <span>→</span>
    <span>
      03 <strong>Tự trả lời</strong>
    </span>
    <span>→</span>
    <span>
      04 <strong>Ôn lại</strong>
    </span>
  </div>
  {groups.map((g) => (
    <section class="catalog-group">
      <h2>{g}</h2>
      <div class="topic-grid">
        {topics
          .filter((t) => t.group === g)
          .map((t) => (
            <a class="topic-card" href={url(`/handbook/${t.id}/`)}>
              <span class="card-meta">
                {t.notes.length} NOTES · {t.questions.length} CÂU HỎI
              </span>
              <h3>{t.title}</h3>
              <p>{t.description}</p>
              <span class="card-cta">Học topic này →</span>
            </a>
          ))}
      </div>
    </section>
  ))}
</Shell>
