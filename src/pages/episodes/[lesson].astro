---
import HandbookLesson from '../../components/HandbookLesson.astro';
import { handbookLessons } from '../../lib/handbook';
export function getStaticPaths() {
  return handbookLessons.filter(l => l.group === 'episode')
    .map(lesson => ({ params: { lesson: lesson.id }, props: { lesson } }));
}
const { lesson } = Astro.props;
---
<HandbookLesson lesson={lesson} />
