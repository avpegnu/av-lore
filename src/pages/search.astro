---
import Shell from '../layouts/Shell.astro';
import Search from '../components/Search';
import { url } from '../lib/url';
---

<Shell title="Tìm kiếm">
  <header class="page-heading">
    <span class="eyebrow">FIND YOUR NEXT ANSWER</span>
    <h1>Bạn muốn hiểu điều gì?</h1>
    <p>Tìm trong toàn bộ nội dung đã xuất bản, bao gồm các chương nền tảng và Notes & Interview.</p>
  </header>
  <Search client:load />
  <noscript>
    <p>
      Bật JavaScript để tìm toàn văn hoặc duyệt <a href={url('/learn/')}>Lộ trình học</a> và{' '}
      <a href={url('/handbook/')}>Handbook</a>.
    </p>
  </noscript>
</Shell>
