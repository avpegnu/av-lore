---
import Shell from '../layouts/Shell.astro';
import { url } from '../lib/url';
---

<Shell title="Không tìm thấy trang">
  <div class="empty-state">
    <span class="eyebrow">404 / LẠC MỘT CHÚT</span>
    <h1>Trang này chưa có ở đây.</h1>
    <p>Chọn lộ trình hoặc tìm bằng tên kiến thức để tiếp tục.</p>
    <div class="lab-actions">
      <a class="button" href={url('/learn/')}>
        Xem lộ trình
      </a>
      <a class="button secondary" href={url('/search/')}>
        Tìm kiếm
      </a>
    </div>
  </div>
</Shell>
