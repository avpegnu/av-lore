---
import Shell from '../layouts/Shell.astro';
import StudyDesk from '../components/StudyDesk';
import { topics, courses } from '../lib/content';
const entries = topics.flatMap((t) => [
  ...t.notes.map((n) => ({
    key: `n/${t.id}/${n.id}`,
    title: n.title,
    topic: t.title,
    href: `/handbook/${t.id}/#note-${n.id}`,
  })),
  ...t.questions.map((q) => ({
    key: `q/${t.id}/${q.id}`,
    title: q.question,
    topic: t.title,
    href: `/handbook/${t.id}/#question-${q.id}`,
  })),
]);
const chapters = courses.map((c) => ({
  id: c.id,
  title: c.title,
  href: `/learn/${c.track}/${c.slug}/`,
}));
---

<Shell title="Góc học tập" wide>
  <header class="page-heading">
    <span class="eyebrow">YOUR STUDY DESK</span>
    <h1>
      Kiến thức của bạn,
      <br />
      theo nhịp của bạn.
    </h1>
    <p>Notes đã lưu, câu hỏi cần ôn và tiến độ đọc. Không cần tài khoản.</p>
  </header>
  <StudyDesk entries={entries} chapters={chapters} client:load />
  <noscript>
    <p>Cần JavaScript để đọc dữ liệu lưu cục bộ và nhập/xuất tệp.</p>
  </noscript>
</Shell>
