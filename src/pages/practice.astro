---
import Shell from '../layouts/Shell.astro';
import Practice from '../components/Practice';
import { topics, url } from '../lib/content';
const items = topics.flatMap((t) =>
  t.questions.map((q) => ({
    key: `q/${t.id}/${q.id}`,
    topic: t.id,
    title: t.title,
    id: q.id,
    question: q.question,
    answer: q.answer,
    explanation: q.explanation,
    followUp: q.followUp,
  })),
);
---

<Shell title="Phòng thực hành" wide>
  <header class="page-heading">
    <span class="eyebrow">03 / PRACTICE</span>
    <h1>Thử. Giải thích. Nhớ.</h1>
    <p>
      Luyện câu hỏi theo hướng công việc hoặc mở mô phỏng trong từng topic. Những gì cần ôn được giữ
      trong Góc học tập.
    </p>
  </header>
  <section>
    <h2>Luyện phỏng vấn tổng hợp</h2>
    <Practice items={items} client:load />
    <noscript>
      <p>
        Bật JavaScript để luyện theo bộ. Bạn có thể đọc mọi câu hỏi và đáp án trong{' '}
        <a href={url('/handbook/')}>Notes & Interview</a>.
      </p>
    </noscript>
  </section>
  <section class="home-section">
    <h2>31 bài thử theo topic</h2>
    <div class="case-grid">
      {topics.map((t, i) => (
        <a href={url(`/handbook/${t.id}/#try`)}>
          <small>{String(i + 1).padStart(2, '0')}</small>
          <strong>{t.title}</strong>
          <span>↗</span>
        </a>
      ))}
    </div>
  </section>
</Shell>
