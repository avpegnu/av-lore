---
import Shell from '../../layouts/Shell.astro';
import themeOptions from '../../lib/themes.json';
import BrandMark from '../../components/BrandMark.astro';
import { url } from '../../lib/url';
---

<Shell title="Thử giao diện" wide>
  <header class="page-heading">
    <span class="eyebrow">THEME STUDIO</span>
    <h1>Chọn màu cho không gian học.</h1>
    <p>
      Bấm Thử theme để áp dụng cho toàn bộ website. Mở một bài học hoặc câu hỏi phỏng vấn để xem
      chữ, code và sơ đồ trong màu mới.
    </p>
    <div class="theme-preview-links">
      <a class="text-link" href={url('/handbook/sql/')}>
        Xem bài học mẫu →
      </a>
      <a class="text-link" href={url('/practice/')}>
        Xem câu hỏi phỏng vấn →
      </a>
    </div>
  </header>
  <section class="theme-filters" aria-label="Lọc giao diện">
    <label class="theme-search">
      Tìm theme
      <input id="theme-query" type="search" placeholder="Tìm theo tên hoặc tông màu…" />
    </label>
    <div class="theme-mode-filters" role="group" aria-label="Độ sáng">
      {[
        ['all', 'Tất cả'],
        ['dark', 'Tối'],
        ['light', 'Sáng'],
      ].map(([mode, label]) => (
        <button
          type="button"
          class="secondary"
          data-theme-filter={mode}
          aria-pressed={mode === 'all'}
        >
          {label}
        </button>
      ))}
    </div>
    <p class="muted" role="status">
      <span id="theme-visible">{themeOptions.length}</span> / {themeOptions.length} THEMES
    </p>
  </section>
  <div class="theme-gallery">
    {themeOptions.map((theme) => (
      <article
        class="theme-preview-card"
        data-theme-card
        data-theme={theme.id}
        data-theme-mode={theme.mode}
      >
        <div class="theme-sample" aria-hidden="true">
          <div class="sample-sidebar">
            <BrandMark size={23} />
            <i></i>
            <i></i>
            <i></i>
          </div>
          <div class="sample-content">
            <span class="sample-eyebrow">NOTES / INTERVIEW</span>
            <strong>Hiểu để ghi nhớ.</strong>
            <p>Giải thích bằng ví dụ, ghi nhớ bằng sơ đồ.</p>
            <div class="sample-code">
              <code>
                <span class="sample-keyword">const</span>
                {' cache = new Map();'}
              </code>
            </div>
            <span class="sample-action">Đọc Notes</span>
          </div>
        </div>
        <div class="theme-card-info">
          <div class="theme-card-title">
            <h2>{theme.name}</h2>
            <span class="theme-mode-label">{theme.mode === 'dark' ? 'Tối' : 'Sáng'}</span>
          </div>
          <p class="theme-card-description">{theme.description}</p>
          <button
            class="secondary theme-apply"
            type="button"
            data-theme-choice={theme.id}
            aria-pressed={theme.id === 'github-dark'}
          >
            <span class="theme-apply-label">Thử theme</span>
            <span class="theme-active-label">✓ Đang dùng</span>
          </button>
        </div>
      </article>
    ))}
  </div>
  <p id="theme-no-results" class="empty-state" hidden>
    Không có theme phù hợp. Thử tên hoặc tông màu khác.
  </p>
</Shell>

<script>
  const cards = [...document.querySelectorAll<HTMLElement>('[data-theme-card]')];
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-filter]')];
  const search = document.querySelector<HTMLInputElement>('#theme-query');
  let mode = 'all';
  const normalize = (value: string) =>
    value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/đ/g, 'd')
      .toLowerCase();
  function filterThemes() {
    const query = normalize(search?.value || '');
    let visible = 0;
    for (const card of cards) {
      const text = normalize(
        (card.querySelector('h2')?.textContent || '') +
          ' ' +
          (card.querySelector('.theme-card-description')?.textContent || '') +
          ' ' +
          card.dataset.theme,
      );
      card.hidden = (mode !== 'all' && card.dataset.themeMode !== mode) || !text.includes(query);
      if (!card.hidden) visible++;
    }
    document.querySelector('#theme-visible')!.textContent = String(visible);
    document.querySelector<HTMLElement>('#theme-no-results')!.hidden = visible !== 0;
  }
  search?.addEventListener('input', filterThemes);
  filters.forEach((button) =>
    button.addEventListener('click', () => {
      mode = button.dataset.themeFilter!;
      filters.forEach((filter) => filter.setAttribute('aria-pressed', String(filter === button)));
      filterThemes();
    }),
  );
</script>

<style>
  .theme-preview-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    font-size: 13px;
    margin-top: 22px;
  }
  .theme-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 16px 24px;
    margin: 32px 0 24px;
  }
  .theme-search {
    flex: 1;
    min-width: 200px;
    font-size: 12px;
    color: var(--muted);
  }
  .theme-search input {
    margin-top: 7px;
    font-size: 14px;
    min-height: 44px;
  }
  .theme-mode-filters {
    display: flex;
    gap: 6px;
  }
  .theme-mode-filters button {
    min-height: 44px;
    font-size: 13px;
  }
  .theme-filters > p {
    font-size: 11px;
    margin: 0;
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .theme-gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .theme-preview-card {
    min-width: 0;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  .theme-preview-card[hidden] {
    display: none;
  }
  .theme-preview-card:has(button[aria-pressed='true']) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .theme-sample {
    display: flex;
    height: 195px;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .sample-sidebar {
    flex: 0 0 43px;
    background: var(--sidebar);
    border-right: 1px solid var(--border);
    padding: 17px 10px;
    color: var(--accent);
  }
  .sample-sidebar i {
    display: block;
    height: 3px;
    background: var(--muted);
    margin: 18px 0 0;
    border-radius: 2px;
    opacity: 0.55;
  }
  .sample-sidebar i:nth-of-type(2) {
    background: var(--accent);
    opacity: 1;
    width: 70%;
  }
  .sample-content {
    min-width: 0;
    flex: 1;
    padding: 18px;
  }
  .sample-eyebrow {
    display: block;
    font-size: 9px;
    font-weight: 650;
    color: var(--accent);
    letter-spacing: 0.8px;
  }
  .sample-content > strong {
    display: block;
    font-size: 18px;
    margin-top: 6px;
    line-height: 1.4;
  }
  .sample-content p {
    font-size: 11px;
    color: var(--muted);
    line-height: 1.6;
    margin: 7px 0;
  }
  .sample-code {
    background: var(--surface-2);
    border: 1px solid var(--border);
    padding: 7px 9px;
    border-radius: 5px;
    margin: 9px 0;
    font-size: 10px;
    line-height: 1.5;
    overflow: hidden;
  }
  .sample-content code {
    background: transparent;
    color: var(--text);
    padding: 0;
    font-size: inherit;
  }
  .sample-keyword {
    color: var(--blue);
  }
  .sample-action {
    display: inline-block;
    background: var(--accent);
    color: var(--sidebar);
    font-size: 10px;
    font-weight: 650;
    padding: 4px 9px;
    border-radius: 4px;
  }
  .theme-card-info {
    padding: 18px;
  }
  .theme-card-title {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 5px 10px;
  }
  .theme-card-title h2 {
    font-size: 18px;
    line-height: 1.4;
    margin: 0;
  }
  .theme-mode-label {
    color: var(--muted);
    font-size: 11px;
  }
  .theme-card-description {
    color: var(--muted);
    font-size: 12px;
    margin: 8px 0 16px;
    min-height: 22px;
  }
  .theme-apply {
    width: 100%;
    font-size: 12px;
    min-height: 40px;
  }
  .theme-active-label,
  [aria-pressed='true'] > .theme-apply-label {
    display: none;
  }
  [aria-pressed='true'] > .theme-active-label {
    display: inline;
  }
  @media (max-width: 1250px) {
    .theme-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 650px) {
    .theme-gallery {
      grid-template-columns: minmax(0, 1fr);
    }
    .theme-filters {
      gap: 12px;
    }
    .theme-search {
      flex-basis: 100%;
    }
    .theme-mode-filters {
      flex: 1;
    }
  }
</style>
