---
import '../styles/global.css';
import { url } from '../lib/url';
import Sidebar from '../components/Sidebar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LanguageMenu from '../components/LanguageMenu.astro';
import ThemeMenu from '../components/ThemeMenu.astro';
import Icon from '../components/Icon.astro';
interface Props {
  title: string;
  description?: string;
  section?: string;
  toc?: { id: string; text: string; depth?: number }[];
  wide?: boolean;
}
const {
  title,
  description = 'Học nền tảng IT, ghi nhớ bằng sơ đồ và luyện phỏng vấn bằng tiếng Việt.',
  toc = [],
  wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="vi" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1f1f1f" />
    <title>{title==='Tổng quan'?'AV Lore — Hiểu bản chất. Học có hệ thống.':`${title} · AV Lore`}</title>
    <link rel="icon" href={url('/favicon.svg?v=av-lore')} type="image/svg+xml" />
    <slot name="head" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('it-basic-theme-v3');
        document.documentElement.dataset.theme = [
          'dark',
          'latte',
          'github-dimmed',
          'midnight',
          'light',
        ].includes(saved || '')
          ? saved
          : 'dark';
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      Đến nội dung chính
    </a>
    <Sidebar />
    <div class="mobile-scrim" id="nav-scrim" hidden></div>
    <div class="workspace">
      <header class="topbar">
        <button
          class="icon-button mobile-toggle"
          id="menu-toggle"
          aria-controls="navigation"
          aria-expanded="false"
          aria-label="Mở điều hướng"
        >
          <Icon name="menu" />
        </button>
        <Breadcrumbs title={title} />
        <div class="top-actions">
          <LanguageMenu />
          <a class="search-link" href={url('/search/')}>
            <Icon name="search" size={17} />
            <span>Tìm kiến thức…</span>
            <kbd>⌘ K</kbd>
          </a>
          <ThemeMenu />

          <a
            class="icon-button github-link"
            href="https://github.com/avpegnu/av-lore"
            aria-label="Mã nguồn GitHub"
          >
            <Icon name="github" />
          </a>
        </div>
      </header>
      <p id="language-status" class="sr-only" role="status"></p>
      <div class:list={['page-grid', { wide, 'has-toc': toc.length > 0 }]}>
        <main id="main" data-pagefind-body>
          <slot />
        </main>
        {toc.length > 0 && (
          <aside class="page-toc" aria-label="Trong trang này" data-pagefind-ignore>
            <p>TRONG TRANG NÀY</p>
            <nav>
              {toc.map((h) => (
                <a class:list={{ sub: h.depth === 3 }} href={`#${h.id}`}>
                  {h.text}
                </a>
              ))}
            </nav>
            <a class="back-top" href="#main">
              ↑ Về đầu trang
            </a>
          </aside>
        )}
      </div>
      <footer class="site-footer">
        <span>AV Lore · Học để hiểu, hiểu để xây dựng.</span>
        <a href={url('/about/')}>Giới thiệu AV Lore</a>
      </footer>
    </div>
    <noscript>
      <style>
        .mobile-toggle {
          display: none;
        }
        @media (max-width: 760px) {
          .sidebar {
            position: relative;
            transform: none !important;
            visibility: visible !important;
            width: 100%;
            height: auto;
            max-height: 320px;
          }
          .sidebar nav {
            max-height: 220px;
          }
          .sidebar-footer {
            display: none;
          }
          .workspace {
            margin: 0;
          }
        }
      </style>
    </noscript>
    <script>
      import { url } from '../lib/url';
      import { initStudy } from '../lib/study';
      import { initLanguage } from '../lib/language';
      initLanguage();
      const menu = document.querySelector<HTMLButtonElement>('#menu-toggle')!,
        scrim = document.querySelector<HTMLElement>('#nav-scrim')!;
      function close() {
        const wasOpen = document.body.classList.contains('nav-open');
        document.body.classList.remove('nav-open');
        menu.setAttribute('aria-expanded', 'false');
        scrim.hidden = true;
        if (wasOpen) menu.focus();
      }
      menu.addEventListener('click', () => {
        const open = !document.body.classList.contains('nav-open');
        document.body.classList.toggle('nav-open', open);
        menu.setAttribute('aria-expanded', String(open));
        scrim.hidden = !open;
        if (open) document.querySelector<HTMLElement>('#navigation a')?.focus();
      });
      scrim.addEventListener('click', close);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
        if (e.key === 'Tab' && document.body.classList.contains('nav-open')) {
          const focusable = [
              ...document.querySelectorAll<HTMLElement>(
                '#navigation a,#navigation button,#navigation summary',
              ),
            ].filter((el) => el.getClientRects().length > 0),
            first = focusable[0],
            last = focusable.at(-1);
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last?.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first?.focus();
          }
        }
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          location.href = url('/search/');
        }
      });
      const themes = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')];
      const themeMenu = document.querySelector<HTMLDetailsElement>('#theme-menu');
      function paintTheme() {
        themes.forEach((b) =>
          b.setAttribute(
            'aria-pressed',
            String(b.dataset.themeChoice === document.documentElement.dataset.theme),
          ),
        );
      }
      themes.forEach((button) =>
        button.addEventListener('click', () => {
          const theme = button.dataset.themeChoice!;
          document.documentElement.dataset.theme = theme;
          try {
            localStorage.setItem('it-basic-theme-v3', theme);
          } catch {}
          paintTheme();
          if (themeMenu) themeMenu.open = false;
        }),
      );
      paintTheme();
      document.addEventListener('click', (event) => {
        if (themeMenu?.open && !themeMenu.contains(event.target as Node)) themeMenu.open = false;
      });
      themeMenu?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          themeMenu.open = false;
          themeMenu.querySelector<HTMLElement>('summary')?.focus();
        }
      });
      const branches = [...document.querySelectorAll<HTMLDetailsElement>('[data-nav-id]')];
      try {
        const saved = JSON.parse(sessionStorage.getItem('it-basic-navigation-v2') || 'null');
        if (saved?.path === location.pathname)
          for (const branch of branches)
            if (typeof saved.open?.[branch.dataset.navId!] === 'boolean')
              branch.open = saved.open[branch.dataset.navId!];
      } catch {}
      function saveNavigation() {
        try {
          sessionStorage.setItem(
            'it-basic-navigation-v2',
            JSON.stringify({
              path: location.pathname,
              open: Object.fromEntries(branches.map((b) => [b.dataset.navId, b.open])),
            }),
          );
        } catch {}
      }
      branches.forEach((branch) => {
        branch.addEventListener('toggle', saveNavigation);
        branch.querySelector(':scope > summary')?.addEventListener('click', (event) => {
          event.preventDefault();
          branch.open = !branch.open;
          saveNavigation();
        });
      });
      const current = document.querySelector<HTMLElement>('#navigation [aria-current="page"]');
      if (current)
        requestAnimationFrame(() => {
          let target: HTMLElement = current;
          for (
            let ancestor = current.parentElement;
            ancestor && ancestor.id !== 'navigation';
            ancestor = ancestor.parentElement
          ) {
            if (ancestor instanceof HTMLDetailsElement && !ancestor.open)
              target = ancestor.querySelector<HTMLElement>('summary') || ancestor;
          }
          target.scrollIntoView({ block: 'nearest', behavior: 'instant' });
        });
      initStudy();
      // Keep the table of contents in sync with reading position.
      const headings = [...document.querySelectorAll('main h2[id],main h3[id]')];
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const e of entries)
              if (e.isIntersecting) {
                document
                  .querySelectorAll('.page-toc a')
                  .forEach((a) =>
                    a.classList.toggle('current', a.getAttribute('href') === '#' + e.target.id),
                  );
              }
          },
          { rootMargin: '-15% 0px -65% 0px' },
        );
        headings.forEach((h) => observer.observe(h));
      }
    </script>
  </body>
</html>
