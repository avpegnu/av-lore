{
  "name": "av-lore",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "test": "tsx --test tests/*.test.ts",
    "build": "astro build && pagefind --site dist && node scripts/build-locales.mjs && pagefind --site dist/en",
    "preview": "astro preview --host 127.0.0.1",
    "migrate": "node scripts/migrate.mjs",
    "verify": "node scripts/verify-build.mjs",
    "test:browser": "node scripts/browser-check.mjs && node scripts/legacy-check.mjs && node scripts/navigation-check.mjs && node scripts/language-check.mjs && node scripts/accessibility-check.mjs",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,css}\" \"scripts/*.mjs\" \"tests/*.ts\" astro.config.mjs",
    "build:vi": "astro build && pagefind --site dist",
    "translate:en": "node scripts/translate-en.mjs",
    "translate:en:offline": "node scripts/translate-en.mjs --offline"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "astro": "7.4.1",
    "cheerio": "1.2.0",
    "pagefind": "1.5.2",
    "postcss": "8.5.31",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
